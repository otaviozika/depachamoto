PORT=3000
# Domínio principal do app (ex.: app.suaempresa.com.br), sem https://. Vazio = desligado.
CANONICAL_HOST=
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# TLS do banco: verificado por padrão na Supabase (certs/supabase-root-ca-2021.crt).
# false = rollback de emergência (TLS sem verificação). true = exige verificação em outros hosts.
DATABASE_SSL_VERIFY=
# Limites por conexão (milissegundos; 0 desativa). Padrões: 60000 e 120000.
DB_STATEMENT_TIMEOUT_MS=
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# Cache da conferência de conta ativa (ms; padrão 10000; 0 desliga). Alterações de admin limpam na hora.
ACCOUNT_CACHE_TTL_MS=
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Integração iFood (mantenha desabilitada até preencher as credenciais)
IFOOD_ENABLED=false
IFOOD_DISPATCH_ENABLED=false
IFOOD_ENVIRONMENT=test
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CUSTOMER_ID=
IFOOD_MERCHANT_ID=
IFOOD_ALLOWED_MERCHANT_IDS=

# Integração Anota AI (credenciais do Portal de Integração)
ANOTAAI_ENABLED=false
ANOTAAI_CLIENT_ID=
ANOTAAI_CLIENT_SECRET=
# Opcional: a tela de Integrações também consegue descobrir/salvar o ID ao vincular a loja.
ANOTAAI_PAGE_ID=

# Google Planilhas — fechamento diário de almoço e janta
# Compartilhe cada planilha mensal com GOOGLE_SERVICE_ACCOUNT_EMAIL como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Legado: planilha única usada pela exportação mensal antiga.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_PREFIX=Pagamentos

# Regra LONGE: Google Routes API (prévia e geração única da zona de 6,7 km)
GOOGLE_ROUTES_API_KEY=

# Conferência de sacolas: API HeiGIT/OpenRouteService (https://api.heigit.org).
# A chave fica somente no servidor. Se ambas existirem, ORS tem prioridade.
OPENROUTESERVICE_API_KEY=
# Opcional: openrouteservice ou google. Deixe vazio para seleção automática segura.
ROUTE_PROVIDER=
# ID do motoboy que usará a conferência na primeira ativação. Defina antes de ligar as flags.
PRE_DEPARTURE_PILOT_COURIER_ID=

# Presença por QR Code
ATTENDANCE_QR_SECRET=

