PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Integração iFood (mantenha desabilitada até preencher as credenciais)
IFOOD_ENABLED=false
IFOOD_DISPATCH_ENABLED=false
IFOOD_ENVIRONMENT=test
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CUSTOMER_ID=
IFOOD_MERCHANT_ID=
IFOOD_ALLOWED_MERCHANT_IDS=

# Integração Anota AI (credenciais do Portal de Integração)
ANOTAAI_ENABLED=false
ANOTAAI_CLIENT_ID=
ANOTAAI_CLIENT_SECRET=
# Opcional: a tela de Integrações também consegue descobrir/salvar o ID ao vincular a loja.
ANOTAAI_PAGE_ID=

# Google Planilhas — fechamento diário de almoço e janta
# Compartilhe cada planilha mensal com GOOGLE_SERVICE_ACCOUNT_EMAIL como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Legado: planilha única usada pela exportação mensal antiga.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_PREFIX=Pagamentos

# Presença por QR Code
ATTENDANCE_QR_SECRET=

